# Copy to .env (repository root) and adjust. Never commit .env.
# The server reads this file on startup; real environment variables take precedence.

# development | production | testing
APP_ENV=development

# Required in production: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# SQLite by default (file created at server/instance/ai_clinic.db).
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db (needs a driver).
DATABASE_URL=

# Model artifacts and training data (paths relative to the repository root).
MODEL_DIR=models
DATASET_PATH=data/updated_synthetic_medical_dataset.csv

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Shown on generated prescription PDFs.
CLINIC_NAME=AI-CLINIC Demo Clinic
CLINIC_ADDRESS=For demonstration purposes only

# INFO | DEBUG | WARNING ; text | json
LOG_LEVEL=INFO
LOG_FORMAT=text

# Used only by `flask --app wsgi seed-demo` to create the demo accounts
# doctor1 and frontdesk1. Pick your own (min 8 characters).
DEMO_DOCTOR_PASSWORD=
DEMO_FRONTDESK_PASSWORD=
